# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Linear Personal API Key (Linear -> Settings -> Security & access -> Personal API keys)
LINEAR_API_KEY=lin_api_your_linear_key_here

# Google Gemini API Key for AI task structuring & voice transcription (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Your Telegram User ID (optional, to restrict bot to only you, comma-separated)
ALLOWED_USER_IDS=
